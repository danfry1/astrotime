{
  "name": "astrotime",
  "version": "0.12.0",
  "description": "Zero-dependency spacecraft & astronomy time for TypeScript: nanosecond instants, leap-second-aware UTC, TAI/TT/GPS/TDB, Julian dates, strict ISO-8601 / day-of-year / duration parse & format",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/astrotime.git"
  },
  "homepage": "https://github.com/danfry1/astrotime#readme",
  "bugs": {
    "url": "https://github.com/danfry1/astrotime/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/stamp-coverage.mjs",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts benchmarks",
    "format": "oxfmt src tests scripts benchmarks tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests scripts benchmarks tsdown.config.ts vitest.config.ts",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "check:release": "bun run check:deps && bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run check:complexity && bun run test:coverage && bun run check:package && bun run test:dist && bun run check:traceability && bun run conformance && bun run evidence",
    "prepare": "test -n \"$CI\" || lefthook install",
    "prepublishOnly": "bun run check:release",
    "bench": "vitest bench --run",
    "conformance": "node scripts/conformance.mjs",
    "check:complexity": "node scripts/check-complexity.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "test:mutation": "stryker run && node scripts/stamp-mutation.mjs",
    "test:differential": "bun run build && python3 scripts/differential.py 100000 reports/differential/report.json && node scripts/stamp-differential.mjs",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "evidence": "node scripts/evidence.mjs",
    "check:deps": "syncpack lint"
  },
  "keywords": [
    "time",
    "leap-seconds",
    "tai",
    "utc",
    "tt",
    "gps",
    "tdb",
    "julian-date",
    "day-of-year",
    "doy",
    "scet",
    "iso-8601",
    "duration",
    "spacecraft",
    "astronomy",
    "space",
    "nasa",
    "openmct"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.26.0",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/plugin-transform-classes": "7.25.9",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "npm": "12.0.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "syncpack": "15.3.3",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
